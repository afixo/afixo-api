# Copy to .dev.vars (gitignored). `wrangler dev` loads it; deployed Workers use `wrangler secret`.

# Console mode: the dashboard's /api/* → gateway console listener
ORIGIN_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:4321

# Machine mode (api.afixo.io in production) → gateway machine listener.
# Locally the dashboard's API Explorer calls the gateway's :8081 directly, so machine mode is
# exercised by the tests rather than by `wrangler dev`; the vars stay so the Env type is stable.
MACHINE_HOSTS=api.localhost
MACHINE_ORIGIN_URL=http://localhost:8081

# 32 random bytes, base64url, no padding. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_KEY=<base64url 32 bytes>

# Cloudflare Access service token (used on both hops). Leave both empty for local dev: the Worker
# only attaches CF-Access-Client-* headers when BOTH are non-empty.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

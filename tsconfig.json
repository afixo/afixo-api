{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    // Runtime + Env types come from `pnpm types` (wrangler types), not @cloudflare/workers-types.
    // "node" is for vitest.config.ts (process.env) and nodejs_compat; the last entry declares `cloudflare:test`.
    "types": ["./worker-configuration.d.ts", "node", "@cloudflare/vitest-pool-workers"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "vitest.config.ts", "worker-configuration.d.ts"]
}
